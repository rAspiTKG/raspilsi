0" width="634.4" height="16.0" as="geometry"/></mxCell><mxCell id="top-242" value="※ 外部ポートは BAYER2RGB_MEM_*(AXI4マスタ)/ BAYER2RGB_REG_*(AXI4-Lite)。BRIDGEの中で s_mem_* / s_reg_* に受ける" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#000000;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="327.0" y="1014.0" width="699.9" height="16.0" as="geometry"/></mxCell><mxCell id="top-243" value="※ vld/busy/data(BAYER2RGB_VBD_IF): vld=1 かつ busy=0 のクロックで1転送。busy=1 の間、送り側は vld と data を保持する" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#000000;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="327.0" y="1040.0" width="673.0" height="16.0" as="geometry"/></mxCell><mxCell id="top-244" value="※ s_ctl_v = フレームの設定(STARTで確定しフレーム中は変わらない)+ start + sw_rst。内部信号は s_、内部レジスタは r_ で始める" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#000000;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="327.0" y="1066.0" width="696.2" height="16.0" as="geometry"/></mxCell><mxCell id="top-245" value="※ 交差は2か所(clk / rst_n を CDC へ引く線と AXI4 書き込みバス)" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#000000;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="327.0" y="1092.0" width="351.7" height="16.0" as="geometry"/></mxCell><mxCell id="top-246" value="" style="ellipse;html=1;fillColor=#2E7D32;strokeColor=#2E7D32;" vertex="1" parent="1"><mxGeometry x="426.5" y="391.5" width="7" height="7" as="geometry"/></mxCell><mxCell id="top-247" value="" style="ellipse;html=1;fillColor=#2E7D32;strokeColor=#2E7D32;" vertex="1" parent="1"><mxGeometry x="1026.5" y="391.5" width="7" height="7" as="geometry"/></mxCell><mxCell id="top-248" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeom