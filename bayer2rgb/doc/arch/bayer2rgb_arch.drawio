52.0" width="127.9" height="16.0" as="geometry"/></mxCell><mxCell id="core-217" value="リセット・制御" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#000000;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="663.0" y="952.0" width="86.5" height="16.0" as="geometry"/></mxCell><mxCell id="core-218" value="AXIバス(1本にまとめて表記)" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#000000;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="816.0" y="952.0" width="157.8" height="16.0" as="geometry"/></mxCell><mxCell id="core-219" value="分岐(接続点)。点のない交差は接続していない" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#000000;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1030.0" y="952.0" width="242.9" height="16.0" as="geometry"/></mxCell><mxCell id="core-220" value="※ s_stp*: 1ステップ = 入力ビート(PPC画素)、行末の掃き出し(1ステップ)、フレーム末の掃き出しライン(K+1ステップ)のどれか" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#000000;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="237.0" y="978.0" width="665.4" height="16.0" as="geometry"/></mxCell><mxCell id="core-221" value="※ IN_CTRLより後ろは固定レイテンシ(合計14)で止まらずに流れる。(s_fifo_cnt + 直近16クロックの発行数) &lt; 32 のときだけ発行する" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#000000;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="237.0" y="1004.0" width="701.8" height="16.0" as="geometry"/></mxCell><mxCell id="core-222" value="※ s_cfg はフレームの開始時だけ変わる。s_clr はソフトリセットの1クロックのパルス" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#000000;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="237.0" y="1030.0" width="454.3" height="16.0" as="geometry"/></mxCell><m