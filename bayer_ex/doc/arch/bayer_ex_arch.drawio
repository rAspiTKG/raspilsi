ry"/></mxCell><mxCell id="pixcor-59" value="i_en &amp;&amp; i_vld で r_data1 に取り込む" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="507.0" y="498.0" width="193.0" height="16.0" as="geometry"/></mxCell><mxCell id="pixcor-60" value="q2 = min(16383, (q1 × gain[色] + 2048) &gt;&gt; 12)" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1067.0" y="462.0" width="233.0" height="16.0" as="geometry"/></mxCell><mxCell id="pixcor-61" value="bypass=1: q2 = q1" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1067.0" y="480.0" width="98.2" height="16.0" as="geometry"/></mxCell><mxCell id="pixcor-62" value="i_en &amp;&amp; r_vld1 で r_data2 に取り込む" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1067.0" y="498.0" width="202.0" height="16.0" as="geometry"/></mxCell><mxCell id="pixcor-63" value="8画素とも同じ式(色だけ位置で変わる)" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=9.5;fontColor=#555555;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="507.0" y="390.2" width="193.5" height="15.5" as="geometry"/></mxCell><mxCell id="pixcor-64" value="積 30bit → 丸め 19bit → 14bit に飽和" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=9.5;fontColor=#555555;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1067.0" y="390.2" width="185.0" height="15.5" as="geometry"/></mxCell><mxCell id="pixcor-65" value="凡例:" style="text;html=1;strokeColor=none;fillColor=none;whiteS